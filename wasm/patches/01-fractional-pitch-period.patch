+/*
+ * choir-practice patch: carry the fractional part of the pitch period from
+ * one period to the next (error diffusion). Stock MBROLA truncates every
+ * period to whole samples, which makes notes up to ~25 cents sharp and turns
+ * vibrato/glides into audible steps; with the carry the mean period equals
+ * the requested one exactly.
+ */
+float mbr_period_residual = 0.0f; /* reset by the wasm entry point before every run */
+static int diffuse_period(float p)
+{
+	float q = p + mbr_period_residual;
+	int n = (int) q;
+	if (n < 1) n = 1;
+	mbr_period_residual = q - (float) n;
+	if (mbr_period_residual > 1.0f || mbr_period_residual < -1.0f) mbr_period_residual = 0.0f;
+	return n;
+}
